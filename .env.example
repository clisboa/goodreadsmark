# Copy to .env and edit locally. Never commit real API keys.
GOODREADS_USER_ID=12345678
GOODREADS_SHELF=to-read
# Shelf must be accessible through the public widget; no Goodreads credentials are used.

SHELFMARK_URL=https://shelfmark.example.com
# Leave empty ONLY for Shelfmark with authentication disabled on a trusted private network.
# Otherwise use the same API key configured in Shelfmark.
SHELFMARK_API_KEY=

PREFERRED_FORMATS=epub,kepub
# Empty inherits Shelfmark search defaults; explicit example: en,pt
PREFERRED_LANGUAGES=
CONTENT_TYPE=ebook
IMPORT_EXISTING=true
DRY_RUN=true
POLL_INTERVAL_MINUTES=30
MAX_DOWNLOADS_PER_RUN=3
MAX_SEARCHES_PER_RUN=20
RETRY_INTERVAL_HOURS=24
MAX_DOWNLOAD_ATTEMPTS=3
LOG_LEVEL=INFO
# This path is for local binary runs. Compose always uses /data inside its volume.
STATE_DB=./data/goodreadsmark.sqlite
# Optional custom image name for local Compose builds.
GOODREADSMARK_IMAGE=ghcr.io/clisboa/goodreadsmark:0.3.1
